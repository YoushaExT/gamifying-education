# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git (it's in .gitignore)

aws_region     = "us-east-1"
aws_profile    = "personal-terraform"  # Your AWS CLI profile name
project_name   = "gamifying-education"
domain_name    = "yousha.click"
route53_zone_id = "Z04364101ZY2RPKY7DZ31" # Find this in Route 53 console

# SSH Configuration
ssh_key_name       = "gamifying-education-key"           # Name of your AWS key pair
allowed_ssh_cidr   = "0.0.0.0/0"   # Change to your IP! (e.g., "203.0.113.5/32")

# Instance Configuration
instance_type = "t4g.micro" # ARM64, Free Tier eligible

# RDS Configuration
# Option A (Recommended): Use db.t3.micro for first year (Free Tier), then switch to db.t4g.micro
# db_instance_class = "db.t3.micro"  # x86, FREE first year (750 hrs/month), then $15/month
# Option B: Use db.t4g.micro from the start (~$12/month, no Free Tier but cheaper long-term)
db_instance_class = "db.t4g.micro"  # ARM64, $12/month
db_allocated_storage     = 20    # GB, Free Tier includes 20GB
db_multi_az              = false # Set true for HA (doubles cost)
db_deletion_protection   = false # Set true for production
db_skip_final_snapshot   = true  # Set false for production

# Database Configuration
db_password = "GENERATE_SECURE_PASSWORD_HERE" # Use: openssl rand -base64 32

# Application Secrets
django_secret_key = "GENERATE_SECRET_KEY_HERE" # Use: openssl rand -base64 32
first_superuser_email    = "yousha234@gmail.com"
first_superuser_password = "GENERATE_SECURE_PASSWORD_HERE" # Use: openssl rand -base64 32

# OpenAI Configuration
openai_api_key = "sk-proj-..." # Your OpenAI API key

# SSL Configuration
admin_email = "yousha234@gmail.com" # For Let's Encrypt notifications

# GitHub Configuration (for CI/CD with OIDC)
github_repo = "YoushaExT/gamifying-education"  # Your GitHub repo in format "owner/repo"

# GitHub Token (for private repositories only)
# Create at: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Required scopes: repo (full control of private repositories)
# Leave empty if repository is public
github_token = ""  # Your GitHub personal access token (keep private!)

# ECR Configuration (Optional - uses defaults from terraform-ecr)
# Only override if you used different names when creating ECR repositories
# ecr_backend_repository_name  = "gamifying-education-backend"
# ecr_frontend_repository_name = "gamifying-education-frontend"

# S3 Configuration (Optional - uses default from terraform-s3)
# Only override if you used a different bucket name when creating S3 bucket
# s3_media_bucket_name = "gamifying-education-production-media"
