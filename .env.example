# Docker Compose Project Name
# This determines the names of Docker volumes, networks, and containers
# Changing this allows you to run multiple isolated instances of the project
# Keep the same name to reuse existing data when moving directories
COMPOSE_PROJECT_NAME=gamifying-education

# Project Configuration
PROJECT_NAME="Gamifying Education"
STACK_NAME=gamifying-education

# Domain
# This is the domain where the frontend will be hosted
# Used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost

# Frontend Host
# Used by the backend to generate links in emails to the frontend
# For local development: http://localhost:5173
# For production: https://yourdomain.com
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local

# Backend
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis-generate-a-secure-random-key-here

# CORS Origins
# Comma-separated list of allowed origins for CORS
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Email Configuration
SMTP_HOST=changethis
SMTP_USER=changethis
SMTP_PASSWORD=changethis
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Superuser (First Admin Account)
FIRST_SUPERUSER=admin@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIRST_SUPERUSER_PASSWORD=changethis-generate-a-secure-password

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=changethis-your-openai-api-key-here
# Model to use for question generation
# Note: gpt-5-mini models only support temperature=1 (custom temperatures are auto-adjusted)
OPENAI_MODEL=gpt-5-mini-2025-08-07
# Temperature for generation (0.0-1.0). Note: gpt-5-mini ignores this and uses 1.0
GENERATION_TEMPERATURE=0.7

# Postgres Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=changethis-generate-a-secure-password

# Media Storage Configuration
# Storage backend: "local" (filesystem) or "s3" (AWS S3)
# Local development should use "local", production should use "s3"
MEDIA_STORAGE_BACKEND=local
# Local filesystem path (only used when MEDIA_STORAGE_BACKEND=local)
MEDIA_LOCAL_PATH=/app/media
# AWS S3 bucket name (only used when MEDIA_STORAGE_BACKEND=s3)
# Create bucket using terraform-s3 directory before setting this
AWS_S3_MEDIA_BUCKET=
# AWS region where S3 bucket is located
AWS_REGION=us-east-1

# Feature Flags (true/false)
FEATURE_AI_QUESTION_GENERATION=true
FEATURE_QUIZ_SYSTEM=true
FEATURE_QUIZ_TIMER=false

# Sentry (Error Tracking - Optional)
SENTRY_DSN=

# Docker Images
# Configure these with your own Docker registry images for production
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Production Deployment (Traefik)
# Only required for production deployments
USERNAME=
HASHED_PASSWORD=
EMAIL=
